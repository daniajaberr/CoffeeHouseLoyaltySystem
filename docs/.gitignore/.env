# JWT secret key - used to sign and verify tokens
# In production, use a long random string (32+ characters)
JWT_SECRET=coffeehouse_super_secret_jwt_key_2024

# AES encryption key - used to encrypt/decrypt sensitive data like phone numbers
# Must be exactly 32 characters for AES-256
AES_SECRET_KEY=coffeeAES256SecretKey12345678901

# Port the server runs on
PORT=3000
